generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Transcript {
  id            Int      @id @default(autoincrement())
  referenceId   String   @unique
  studentName   String
  studentId     String
  age           String
  gender        String
  stream        String
  photo         Bytes
  photoMimeType String
  photoName     String
  photoSize     Int
  transcript    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  image         Bytes?
  imageMimeType String?
  imageSize     Int?
  pdf           Bytes?
  pdfSize       Int?
   pngUrl          String?
  pdfUrl          String?
}
